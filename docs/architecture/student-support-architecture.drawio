  <diagram id="page-7" name="07 Case workflow and controlled referral">
    <mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="07 Case workflow and controlled referral" style="text;html=0;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172b3a;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="30" width="1510" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="Business transitions • separate role gates and referral lifecycle from case status • configurable release v3" style="text;html=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#526574;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="95" width="1510" height="45" />
