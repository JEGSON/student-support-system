        <mxCell id="user" value="USERS&#10;&#10;Internal identity and current account status. Memberships determine current staff scope." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="200" width="330" height="160" />
        </mxCell>
        <mxCell id="session" value="SESSIONS / AUTH ATTEMPTS&#10;&#10;Hashed token + workspace; nonce/PKCE&#10;Independent idle/absolute expiry&#10;Fresh auth_time for account deletion" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="635" y="200" width="330" height="160" />
        </mxCell>
        <mxCell id="browser" value="BROWSER / SHARED LIMITS&#10;&#10;Separate /student and /university&#10;HttpOnly cookies + CSRF; shared limits&#10;Same-workspace tabs share sign-in" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff1db;strokeColor=#936626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="200" width="330" height="160" />
        </mxCell>
        <mxCell id="case" value="CASE TRANSACTION&#10;&#10;Business change + case event&#10;+ audit event + outbox job&#10;Commit or roll back together" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="480" width="330" height="170" />
        </mxCell>
        <mxCell id="audit" value="AUDIT EVENTS&#10;&#10;actor; action; target; outcome&#10;request_id; occurred_at&#10;No free-text narrative" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="635" y="480" width="330" height="170" />
        </mxCell>
        <mxCell id="outbox" value="NOTIFICATION OUTBOX&#10;&#10;event key [unique per recipient/channel]&#10;state; lease; retry count&#10;Generic template only" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="480" width="330" height="170" />
        </mxCell>
        <mxCell id="review" value="ENROLMENT / PRIVACY REVIEW&#10;&#10;Verified one-use invitations; closure records and policy reviews. Separate scoped audit reader." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff1db;strokeColor=#936626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="635" y="760" width="330" height="135" />
        </mxCell>
        <mxCell id="worker" value="RESTRICTED WORKER&#10;&#10;Lease jobs; resolve contact; send; mark outcome. No narrative read." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="760" width="330" height="135" />
        </mxCell>
        <mxCell id="backup" value="RECOVERY / DISPOSAL&#10;&#10;Encrypted snapshot; restore quarantine&#10;Case + closure ledger replay&#10;Clear sessions, invitations and stale mail" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="760" width="330" height="135" />
        </mxCell>
        <mxCell id="note" value="20 collection contracts&#10;&#10;Additional stores: enrolment invitations and account closures. Team routes are unique; closure fingerprints prevent re-enrolment. Retention periods require configured policy; backup/closure ledgers replay in quarantine." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff9e8;strokeColor=#a3852d;strokeWidth=1.5;" vertex="1" parent="1">
