            <mxPoint as="targetPoint" x="1085.0" y="545" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-4" value="5 Commit or abort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526574;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1085.0" y="620" />
            <mxPoint as="targetPoint" x="785.0" y="620" />
