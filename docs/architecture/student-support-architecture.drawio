        <mxCell id="submit" value="Student submits&#10;&#10;Owner and timestamps set by server. Category maps to accountable team." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff1db;strokeColor=#936626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="200" width="280" height="130" />
        </mxCell>
        <mxCell id="new" value="NEW&#10;&#10;Manager assigns eligible officer. Assignment alone does not start work." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="200" width="280" height="130" />
        </mxCell>
        <mxCell id="progress" value="IN PROGRESS&#10;&#10;Assigned officer or scoped manager handles the case." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="830" y="200" width="280" height="130" />
        </mxCell>
        <mxCell id="await" value="AWAITING STUDENT&#10;&#10;Staff post a visible request for information." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="200" width="280" height="130" />
        </mxCell>
        <mxCell id="closed" value="CLOSED&#10;&#10;Resolution required. Manager may reopen with reason and valid assignment." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="830" y="480" width="280" height="145" />
        </mxCell>
        <mxCell id="archive" value="ARCHIVED FLAG&#10;&#10;Separate lifecycle attribute. Retention review and legal-hold checks." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="480" width="280" height="145" />
        </mxCell>
        <mxCell id="dispose" value="POLICY-BASED DISPOSAL&#10;&#10;Configured category retention, hold checks, independent approval and offline executor. One-day fallback is local-only." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="480" width="280" height="145" />
        </mxCell>
        <mxCell id="proposal" value="1 Propose referral&#10;&#10;Assigned officer provides purpose and selected summary; source manager approves." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="760" width="390" height="140" />
        </mxCell>
        <mxCell id="decision" value="2 Target manager decides&#10;&#10;Only approved proposal information is visible. Accept or reject with recorded decision." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="605" y="760" width="390" height="140" />
        </mxCell>
        <mxCell id="targetcase" value="3 Separate target case&#10;&#10;Acceptance creates New case in target team. No inherited source-note access." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="760" width="390" height="140" />
        </mxCell>
        <mxCell id="note" value="Reading this diagram&#10;&#10;Reopening: Closed → In Progress is manager-only and audited. Awaiting Student must return to In Progress before closure; no automatic closure for silence in v1. Referral leaves source status unchanged. Urgent-help and operating-hours procedures remain institutional approval gates." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff9e8;strokeColor=#a3852d;strokeWidth=1.5;" vertex="1" parent="1">
