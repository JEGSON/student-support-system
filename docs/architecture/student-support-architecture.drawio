          <mxGeometry as="geometry" x="820" y="570" width="300" height="100" />
        </mxCell>
        <mxCell id="unit" value="Transaction coordinator&#10;&#10;Version guard; case changes + business history + audit + outbox commit together. No email call inside transaction." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="445" width="330" height="225" />
        </mxCell>
        <mxCell id="repo" value="Repositories → private MongoDB&#10;&#10;Allowlisted filters; scoped queries; validators; indexes; session and audit persistence." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e8f3ec;strokeColor=#37704b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="775" width="580" height="110" />
        </mxCell>
        <mxCell id="note" value="Implemented boundaries&#10;&#10;Server services enforce current permissions and transactions. DB identities separate web, worker, audit reader, maintenance and restore access. No real university integration." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff9e8;strokeColor=#a3852d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="950" width="1500" height="85" />
