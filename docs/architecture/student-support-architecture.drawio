        <mxCell id="worker" value="Worker / email&#10;&#10;" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="175" width="250" height="80" />
        </mxCell>
        <mxCell id="note" value="Reading this diagram&#10;&#10;If validation or authorisation fails: no transaction. If audit/outbox write fails: roll back case creation. Retry with same key returns one result. If email fails: case remains saved; retry delivery. If response is lost after commit: same key recovers the saved reference." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#fff9e8;strokeColor=#a3852d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="950" width="1500" height="85" />
        </mxCell>
        <mxCell id="edge-0" value="1 POST form + CSRF + submission key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526574;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="185.0" y="320" />
            <mxPoint as="targetPoint" x="485.0" y="320" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-1" value="2 Validate session, owner and typed input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526574;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="485.0" y="395" />
            <mxPoint as="targetPoint" x="785.0" y="395" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="3 Check key; begin transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526574;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="785.0" y="470" />
            <mxPoint as="targetPoint" x="1085.0" y="470" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-3" value="4 Insert case + event + audit + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526574;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
