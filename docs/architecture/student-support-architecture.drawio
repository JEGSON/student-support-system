        <mxCell id="svc" value="Policy / service&#10;&#10;" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontSize=16;fillColor=#e7f1fa;strokeColor=#30658a;strokeWidth=1.5;" vertex="1" parent="1">
