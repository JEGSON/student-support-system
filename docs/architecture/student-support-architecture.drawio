        <mxCell id="subtitle" value="Successful path plus failure guarantees • database transaction excludes external email calls • configurable release v3" style="text;html=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#526574;whiteSpace=wrap;" vertex="1" parent="1">
