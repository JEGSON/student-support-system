        <mxCell id="edge-3" value="Student reply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526574;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="await" target="progress">
          <mxGeometry as="geometry" relative="1">
