# Worker-only secrets. Never inject this file into the web service.
APP_ENV=production
EMAIL_DELIVERY_ENABLED=0
APP_BASE_URL=https://support.REPLACE_UNIVERSITY_DOMAIN
MONGODB_DATABASE=student_support_university
MONGODB_WORKER_URI=REPLACE_WITH_RESTRICTED_WORKER_MONGODB_URI_USING_VERIFIED_TLS
NOTIFICATION_PRINCIPAL_ID=REPLACE_WITH_UUID_RETURNED_BY_OPERATOR_BOOTSTRAP
SMTP_HOST=REPLACE_WITH_APPROVED_SMTP_HOST
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=REPLACE_WITH_SMTP_ACCOUNT
SMTP_PASSWORD=REPLACE_WITH_SMTP_SECRET
SMTP_FROM=REPLACE_WITH_APPROVED_SENDER_ADDRESS
