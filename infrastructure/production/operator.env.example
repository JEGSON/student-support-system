# Offline operators use these in addition to approved web configuration.
# NEVER inject operator credentials into web or notification processes.
MONGODB_SCHEMA_URI=REPLACE_WITH_OFFLINE_DBADMIN_URI_USING_VERIFIED_TLS
MONGODB_MAINTENANCE_URI=REPLACE_WITH_OFFLINE_MAINTENANCE_URI_USING_VERIFIED_TLS
MONGODB_BACKUP_URI=REPLACE_WITH_READ_ONLY_BACKUP_URI_USING_VERIFIED_TLS
MONGODB_RESTORE_URI=REPLACE_WITH_RESTORE_ONLY_QUARANTINE_URI_USING_VERIFIED_TLS
BACKUP_DIRECTORY=/REPLACE/APPROVED/PRIVATE/BACKUP_DIRECTORY
BACKUP_KEY_FILE=/REPLACE/SEPARATE/PRIVATE/KEY_DIRECTORY/backup.key
