# Configuration template only. Inject real values through the web service's secret store.
APP_ENV=production
FLASK_DEBUG=0
APP_BASE_URL=https://support.REPLACE_UNIVERSITY_DOMAIN
SECRET_KEY=REPLACE_WITH_GENERATED_WEB_SECRET_AT_LEAST_48_CHARACTERS
IDENTITY_FINGERPRINT_KEY=REPLACE_WITH_SEPARATE_STABLE_IDENTITY_KEY_AT_LEAST_48_CHARACTERS
IDENTITY_FINGERPRINT_PREVIOUS_KEYS=[]
MONGODB_URI=REPLACE_WITH_RESTRICTED_WEB_MONGODB_URI_USING_VERIFIED_TLS
MONGODB_DATABASE=student_support_university
MONGO_MAX_POOL_SIZE=20
OIDC_ISSUER=https://identity.REPLACE_UNIVERSITY_DOMAIN/realms/university
OIDC_CLIENT_ID=REPLACE_WITH_APPROVED_OIDC_CLIENT
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_REQUIRED_ACR=REPLACE_WITH_APPROVED_STAFF_AUTHENTICATION_CLASS
OIDC_ACCOUNT_URL=https://identity.REPLACE_UNIVERSITY_DOMAIN/realms/university/account
ENROLMENT_MODE=invitation
SELF_REGISTRATION_ENABLED=0
CASE_ROUTING_SOURCE=database
CASE_ROUTING_JSON={}
EMAIL_HEALTH_URL=https://REPLACE_APPROVED_DELIVERY_HEALTH_ENDPOINT
INSTITUTION_NAME=REPLACE_WITH_UNIVERSITY_NAME
PRIVACY_CONTACT=REPLACE_WITH_REAL_PRIVACY_CONTACT
PRIVACY_NOTICE=REPLACE_WITH_APPROVED_PRIVACY_NOTICE
SERVICE_HOURS_TEXT=REPLACE_WITH_APPROVED_HOURS_AND_RESPONSE_INFORMATION
URGENT_HELP_TEXT=REPLACE_WITH_APPROVED_URGENT_HELP_PROCEDURE
# Set to 1 only after the responsible operator has reviewed the actual service policies.
SERVICE_POLICY_APPROVED=0
RETENTION_POLICY_REFERENCE=REPLACE_WITH_APPROVED_POLICY_VERSION
# JSON day values must be integers from the approved policy; no real duration is supplied here.
RETENTION_DAYS_JSON={"academic":"REPLACE","finance":"REPLACE","wellbeing":"REPLACE","disability":"REPLACE","accommodation":"REPLACE"}
TRUST_PROXY=1
PROXY_HOPS=1
PROXY_TRUSTED_IP=REPLACE_WITH_EXACT_PROXY_PEER_IP
RATE_LIMIT_ENABLED=1
RATE_LIMIT_READ=600
RATE_LIMIT_WRITE=120
RATE_LIMIT_IDENTITY=30

ACCOUNT_PRIVACY_REVIEW_DAYS=REPLACE_WITH_APPROVED_REVIEW_INTERVAL
