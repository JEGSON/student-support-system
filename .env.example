# PLACEHOLDERS ONLY. Generate local .env with python3 scripts/setup_local.py.
APP_ENV=development
FLASK_DEBUG=0
APP_BASE_URL=http://127.0.0.1:5050
SECRET_KEY=REPLACE_WITH_GENERATED_LOCAL_SECRET
MONGODB_URI=REPLACE_WITH_LOCAL_AUTHENTICATED_REPLICA_SET_URI
MONGODB_DATABASE=student_support_dev
OIDC_ISSUER=http://127.0.0.1:8180/realms/student-support
OIDC_CLIENT_ID=support-local
EMAIL_HEALTH_URL=http://127.0.0.1:8025/readyz
MONGO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_BOOTSTRAP_SECRET
MONGO_APP_PASSWORD=REPLACE_WITH_GENERATED_APP_SECRET
MONGO_TEST_PASSWORD=REPLACE_WITH_GENERATED_TEST_SECRET
OIDC_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SYNTHETIC_BOOTSTRAP_SECRET
MONGO_SCHEMA_PASSWORD=REPLACE_WITH_GENERATED_SCHEMA_SETUP_SECRET
# Initial per-process bound, subject to later workload tuning (valid range 1–100).
MONGO_MAX_POOL_SIZE=20

# Local public client only. Production requires reviewed provider configuration.
OIDC_TOKEN_AUTH_METHOD=none
# OIDC_CLIENT_SECRET=REPLACE_WITH_CONFIDENTIAL_CLIENT_SECRET_IF_REQUIRED
# OIDC_REQUIRED_ACR=REPLACE_WITH_INSTITUTION_APPROVED_AUTHENTICATION_CLASS
# Stage 07: offline maintenance and environment-separated restricted identities.
MONGO_FIXTURE_PASSWORD=REPLACE_WITH_GENERATED_DEV_MAINTENANCE_SECRET
MONGO_WEB_TEST_PASSWORD=REPLACE_WITH_GENERATED_RESTRICTED_TEST_WEB_SECRET
MONGO_AUDIT_PASSWORD=REPLACE_WITH_GENERATED_DEV_AUDIT_READER_SECRET
MONGO_AUDIT_TEST_PASSWORD=REPLACE_WITH_GENERATED_TEST_AUDIT_READER_SECRET
MONGO_WORKER_PASSWORD=REPLACE_WITH_GENERATED_DEV_WORKER_SECRET
MONGO_WORKER_TEST_PASSWORD=REPLACE_WITH_GENERATED_TEST_WORKER_SECRET

# Explicit synthetic routes are generated only by scripts/configure_routing.py.
# Missing routes safely refuse affected submissions (no arbitrary fallback).
CASE_ROUTING_JSON={}
